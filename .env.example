# PostgreSQL superuser (used only by scripts/setup.sh)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-postgres
OWNER_PASSWORD=change-me-owner
APP_PASSWORD=change-me-app
READONLY_PASSWORD=change-me-readonly

# MongoDB
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me-root
MONGO_APP_PASSWORD=change-me-mongo-app

# Redis
REDIS_PASSWORD=change-me-redis

# URLs for scripts run from your machine with `uv run`
MIGRATION_DATABASE_URL=postgresql://music_owner:change-me-owner@127.0.0.1:5432/music
DATABASE_URL=postgresql://music_app:change-me-app@127.0.0.1:5432/music
READONLY_DATABASE_URL=postgresql://music_ro:change-me-readonly@127.0.0.1:5432/music
MONGO_ROOT_URL=mongodb://root:change-me-root@127.0.0.1:27017/admin
MONGO_URL=mongodb://music_app:change-me-mongo-app@127.0.0.1:27017/music
REDIS_URL=redis://:change-me-redis@127.0.0.1:6379/0